# 生产配置；密钥生成：python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_ENV=production
SECRET_KEY=
PUBLIC_ORIGIN=https://learn.example.com

# 相对 backend 工作目录；compose 中挂到 /app/data
DATABASE_URL=sqlite:///data/leetpath.db

TOKEN_TTL_DAYS=7
COOKIE_NAME=leetpath_token
COOKIE_SECURE=true

# Cloudflare Zero Trust 控制台创建 Tunnel 后复制 token，禁止提交真实值
CLOUDFLARE_TUNNEL_TOKEN=

# 每日 SQLite 在线备份，保留最近 7 份
BACKUP_DIR=/app/backups
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION=7

POLL_INTERVAL=1.0
JUDGE_IMAGE_PYTHON=leetpath-judge-python
JUDGE_IMAGE_CPP=leetpath-judge-cpp
DOCKER_BIN=docker

# judge 容器访问宿主 docker.sock 所需的 docker 组 gid；查询：stat -c %g /var/run/docker.sock
DOCKER_GID=999

# AI 助教代理允许转发的目标域名（逗号分隔）；更换/新增中转站时在此追加，例如 ,your-relay.example.com
# 填了中转站 key 后 POST /api/ai/models 若 502，先确认 backend 已挂 egress 网且本列表含该域名
AI_ALLOWED_HOSTS=api.antithor.asia,api.deepseek.com
