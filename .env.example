# 生产必须替换。生成：python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-secret-change-me

# 相对 backend 工作目录；compose 中挂到 /app/data
DATABASE_URL=sqlite:///data/leetpath.db

TOKEN_TTL_DAYS=7
COOKIE_NAME=leetpath_token
# 生产建议 true（需 HTTPS）
COOKIE_SECURE=false

POLL_INTERVAL=1.0
JUDGE_IMAGE_PYTHON=leetpath-judge-python
JUDGE_IMAGE_CPP=leetpath-judge-cpp
DOCKER_BIN=docker
